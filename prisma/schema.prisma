generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Tenant {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  subdomain    String        @unique
  customDomain String?       @unique
  websiteUrl   String? // marketing site for the "Back to website" link on login
  status       TenantStatus  @default(ACTIVE)
  brandName    String?
  slogan       String? // tagline shown under the brand name on login/register
  companyInfo  String? // brokerage/company footer line (e.g. legal entity, address)
  logoUrl      String?
  faviconUrl   String?
  primaryColor String?       @default("#2563eb")
  accentColor  String?       @default("#22c55e")
  supportEmail String?
  contactPhone String? // SuperAdmin-only contact phone for the tenant (never shown publicly)
  contactName  String? // SuperAdmin-only primary contact person (never shown publicly)
  smtpEmail    String?
  smtpPassword String?
  smtpHost     String? // explicit SMTP server (e.g. mail.privateemail.com); blank = auto-detect from email domain
  permissions  Json          @default("{}")
  allowRegistration Boolean   @default(true) // show the client Register link on this tenant's login
  swapEnabled  Boolean       @default(false) // SuperAdmin controls: enables overnight swap charges for this tenant
  subscription     Subscription?
  invoices         Invoice[]
  expiredAccounts  ExpiredAccount[]
  users        User[]
  accounts     Account[]
  symbols      Symbol[]
  groups       TradeGroup[]
  counters     Counter[]
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
model Subscription {
  id        String    @id @default(uuid())
  tenantId  String    @unique
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      Plan      @default(STARTER)
  status    SubStatus @default(TRIALING)
  seats     Int       @default(5)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
model Invoice {
  id        String        @id @default(uuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number    String        @unique
  period    String
  plan      Plan          @default(STARTER)
  amount    Decimal       @db.Decimal(10, 2)
  status    InvoiceStatus @default(PENDING)
  dueAt     DateTime
  paidAt    DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  @@index([tenantId])
}
model User {
  id              String     @id @default(uuid())
  tenantId        String?
  tenant          Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String
  passwordHash    String
  pinHash         String?
  emailToken      String?
  webauthnChallenge String?
  avatarUrl       String?
  name            String
  phone           String?
  country         String?
  role            Role       @default(CLIENT)
  status          UserStatus @default(ACTIVE)
  perms           Json       @default("{}")
  lastLoginAt     DateTime?
  lastLoginIp     String?
  lastSeenAt      DateTime?
  lastDevice      String?
  activeSession   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  accounts        Account[]  @relation("AccountOwner")
  managedAccounts Account[]  @relation("ManagerAccounts")
  managedGroups   TradeGroup[] @relation("ManagerGroups")
  // Email is unique per (tenant, role) so the same person can be e.g. both a
  // CLIENT (trader) and a MANAGER under one tenant. Login disambiguates by password.
  @@unique([tenantId, email, role])
  @@index([role])
  @@index([tenantId, email])
}
model Account {
  id              String             @id @default(uuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  login           String
  userId          String?
  user            User?              @relation("AccountOwner", fields: [userId], references: [id], onDelete: SetNull)
  name            String
  email           String?
  phone           String?
  country         String?
  type            AccountType        @default(LIVE)
  leverage        Int                @default(100)
  currency        Currency           @default(USD)
  mcLevel         Decimal            @default(50) @db.Decimal(6, 2)
  swapFree        Boolean            @default(false) // Islamic account — no swap charged
  doNotLiquidate  Boolean            @default(false)
  locked          Boolean            @default(false)
  deactivated     Boolean            @default(false)
  isPool          Boolean            @default(false)
  isOnline        Boolean            @default(false)
  lastPing        DateTime?
  lastDevice      String?
  kycStatus       KycStatus?
  deposit         Decimal            @default(0) @db.Decimal(18, 2)
  withdrawal      Decimal            @default(0) @db.Decimal(18, 2)
  credit          Decimal            @default(0) @db.Decimal(18, 2)
  bonus           Decimal            @default(0) @db.Decimal(18, 2)
  insurance       Decimal            @default(0) @db.Decimal(18, 2)
  pnl             Decimal            @default(0) @db.Decimal(18, 2)
  spreadMarkup    Decimal            @default(0) @db.Decimal(10, 2)
  spreadMarkupType String            @default("FIXED")
  spreadMarkupMax Decimal            @default(0) @db.Decimal(10, 2)
  managerId       String?
  manager         User?              @relation("ManagerAccounts", fields: [managerId], references: [id], onDelete: SetNull)
  parentId        String?
  parent          Account?           @relation("SubAccounts", fields: [parentId], references: [id], onDelete: SetNull)
  children        Account[]          @relation("SubAccounts")
  groupId         String?
  group           TradeGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  trades          Trade[]
  history         TradeHistory[]
  financials      FinancialHistory[]
  kyc             KycDocument[]
  paymentRequests PaymentRequest[]
  pendingOrders   PendingOrder[]
  symbolOverrides AccountSymbolOverride[]
  priceAlerts     PriceAlert[]
  expiresAt       DateTime?          // DEMO only: set to createdAt+30d; null = never expires (LIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  @@unique([tenantId, login])
  @@index([tenantId])
  @@index([expiresAt])
}
model Counter {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  nextVal  BigInt @default(800100)
  @@unique([tenantId, name])
}
model Trade {
  id        BigInt   @id @default(autoincrement())
  ticket    BigInt   @unique
  accountId String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol        String
  type          Side
  lots          Decimal  @db.Decimal(10, 2)
  openPrice     Decimal  @db.Decimal(18, 5)
  sl            Decimal  @default(0) @db.Decimal(18, 5)
  tp            Decimal  @default(0) @db.Decimal(18, 5)
  trailingStop  Decimal  @default(0) @db.Decimal(18, 5) // trailing stop distance in price units; 0 = disabled
  commission    Decimal  @default(0) @db.Decimal(18, 2)
  swap          Decimal  @default(0) @db.Decimal(18, 2)
  comment       String?
  openedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  @@index([accountId])
  @@index([symbol])
}
model TradeHistory {
  id          BigInt      @id @default(autoincrement())
  ticket      BigInt
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol      String
  side        Side
  lots        Decimal     @db.Decimal(10, 2)
  openPrice   Decimal     @db.Decimal(18, 5)
  closePrice  Decimal     @db.Decimal(18, 5)
  sl          Decimal     @default(0) @db.Decimal(18, 5)
  tp          Decimal     @default(0) @db.Decimal(18, 5)
  pnl         Decimal     @db.Decimal(18, 2)
  commission  Decimal     @default(0) @db.Decimal(18, 2)
  swap        Decimal     @default(0) @db.Decimal(18, 2)
  comment     String?
  closeReason CloseReason @default(MANUAL)
  openedAt    DateTime
  closedAt    DateTime    @default(now())
  @@index([accountId])
  @@index([closedAt])
}
model FinancialHistory {
  id          BigInt   @id @default(autoincrement())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        FinType
  amount      Decimal  @db.Decimal(18, 2)
  description String?
  reference   String?
  mode        FinMode  @default(REALTIME)
  appliedAt   DateTime @default(now())
  createdBy   String   @default("admin")
  createdAt   DateTime @default(now())
  @@index([accountId])
}
model Symbol {
  id         String  @id @default(uuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  symbol     String
  display    String
  category   String  @default("forex")
  digits     Int     @default(5)
  feed       String?
  spread           Decimal @default(0) @db.Decimal(10, 2)
  spreadType       String  @default("FIXED")
  spreadMax        Decimal @default(0) @db.Decimal(10, 2)
  // markup: extra pips added on top of live bid/ask spread (for BN/KR feeds). 0 = no markup.
  markup           Decimal @default(0) @db.Decimal(10, 2)
  swapLong         Decimal @default(0) @db.Decimal(10, 5) // swap rate for BUY positions (pips per night)
  swapShort        Decimal @default(0) @db.Decimal(10, 5) // swap rate for SELL positions (pips per night)
  commissionPerLot Decimal @default(0) @db.Decimal(10, 2) // commission charged per lot on open
  enabled          Boolean @default(true)
  @@unique([tenantId, symbol])
}
model AccountSymbolOverride {
  id             String   @id @default(uuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol         String
  disabled       Boolean  @default(true)
  // spreadOverride: pips override for this client+symbol. null = use group/default. 0 = zero spread.
  spreadOverride Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  @@unique([accountId, symbol])
  @@index([accountId])
}
// Client request for an ADDITIONAL live account — needs tenant-admin approval
// (first live account is auto-created; extra ones are gated to limit data/seats).
model AccountRequest {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  type       String    @default("LIVE")
  leverage   Int       @default(100)
  currency   String    @default("USD")
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note       String?
  reviewedBy String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  @@index([tenantId, status])
  @@index([userId])
}
model TradeGroup {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  // markup: extra pips added on top of live/symbol spread for every symbol in this group
  spread     Decimal   @default(0) @db.Decimal(10, 2)
  spreadType String    @default("FIXED")
  spreadMax  Decimal   @default(0) @db.Decimal(10, 2)
  config     Json      @default("{}")
  // null = admin-level group; set = group belongs to this manager (3-level: manager > group > client)
  managerId  String?
  manager    User?     @relation("ManagerGroups", fields: [managerId], references: [id], onDelete: SetNull)
  accounts   Account[]
  symbolOverrides TradeGroupSymbolOverride[]
  @@unique([tenantId, name])
  @@index([managerId])
}
// Per-symbol spread override for a TradeGroup — overrides live+markup for specific symbols.
model TradeGroupSymbolOverride {
  id      String     @id @default(uuid())
  groupId String
  group   TradeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  symbol  String
  // spread: fixed pips for this symbol in this group. -1 = use global default. 0 = zero spread.
  spread  Decimal    @db.Decimal(10, 2)
  @@unique([groupId, symbol])
  @@index([groupId])
}
model KycDocument {
  id         String    @id @default(uuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  docType    String
  fileUrl    String // front side
  backUrl    String? // back side (required for verification)
  mimeType   String?
  status     KycStatus @default(PENDING)
  note       String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
}
model AuditLog {
  id          BigInt        @id @default(autoincrement())
  tenantId    String?
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action      String
  detail      String?
  category    AuditCategory @default(ADMIN)
  performedBy String        @default("Admin")
  device      String?
  ipAddress   String?
  createdAt   DateTime      @default(now())
  @@index([category])
  @@index([createdAt])
}
model Setting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// Server-to-server API key for external integrations (e.g. a tenant's website
// pulling a pool account's P&L). Scoped to ONE tenant. We store only the sha256
// hash of the secret + a short prefix for display — the raw key is shown once.
model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  label      String
  keyHash    String    @unique
  prefix     String
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  @@index([tenantId])
}
model CryptoWallet {
  id        String   @id @default(uuid())
  // null = global default created by SuperAdmin, available to every tenant.
  // set   = belongs to a specific tenant (added by SA per-tenant or by tenant admin).
  tenantId  String?
  type      String   @default("CRYPTO") // CRYPTO | UPI | LINK | BANK
  network   String   @default("") // crypto: BEP20 / ERC20 / TRC20
  asset     String   @default("USDT")
  address   String   @default("") // crypto address / UPI id / bank account number
  label     String? // display name (e.g. "Local Pay", "GPay UPI", bank name)
  url       String? // for LINK type (local payment partner)
  details   Json? // BANK: { accountNumber, accountName, bankName, ifsc }
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  @@index([tenantId])
}

model WithdrawalMethod {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  type      String   @default("CRYPTO") // CRYPTO | UPI | BANK
  network   String? // crypto network
  asset     String?  @default("USDT")
  address   String // wallet address / UPI id / account no
  label     String // friendly name e.g. "My Binance USDT"
  details   Json? // extra fields (bank name, ifsc, holder)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId])
}
model PendingOrder {
  id        String    @id @default(uuid())
  tenantId  String
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol    String
  side      Side
  kind      String
  lots      Decimal   @default(0) @db.Decimal(18, 2)
  price     Decimal   @default(0) @db.Decimal(18, 8)
  sl        Decimal   @default(0) @db.Decimal(18, 8)
  tp        Decimal   @default(0) @db.Decimal(18, 8)
  stopLimit Decimal   @default(0) @db.Decimal(18, 8) // for STOP_LIMIT: limit price after stop triggers
  comment   String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  @@index([accountId])
}

model PriceAlert {
  id        String   @id @default(uuid())
  tenantId  String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol    String
  condition String   // ABOVE | BELOW
  price     Decimal  @db.Decimal(18, 5)
  note      String?
  triggered Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([accountId])
  @@index([tenantId])
}
model PaymentRequest {
  id           String        @id @default(uuid())
  tenantId     String
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind         PaymentKind
  amount       Decimal       @db.Decimal(18, 2)
  method       String?
  details      Json          @default("{}")
  slipUrl      String?
  note         String?
  status       RequestStatus @default(PENDING)
  reviewedBy   String?
  rejectReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@index([tenantId])
  @@index([accountId])
}
model Notification {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  title       String
  body        String?
  image       String?
  type        String?
  senderId    String?
  senderRole  String?
  targetScope String?
  batchId     String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([userId])
  @@index([batchId])
}
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  @@index([userId])
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  transports   String?
  deviceType   String?
  backedUp     Boolean  @default(false)
  createdAt    DateTime @default(now())
  @@index([userId])
}
// Permanent history record written before a demo account is hard-deleted on expiry.
model ExpiredAccount {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantName  String
  clientName  String
  clientEmail String?
  login       String
  type        String   @default("DEMO")
  balance     Decimal  @default(0) @db.Decimal(18, 2)
  expiredAt   DateTime
  createdAt   DateTime @default(now())
  @@index([tenantId])
  @@index([expiredAt])
}

model GlobalSymbol {
  id        String   @id @default(uuid())
  symbol    String   @unique
  display   String
  category  String   @default("forex")
  digits    Int      @default(5)
  feed      String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FeedFailoverLog {
  id        Int      @id @default(autoincrement())
  fromFeed  String
  toFeed    String
  reason    String?
  ts        DateTime @default(now())
}

model FeedErrorLog {
  id        Int      @id @default(autoincrement())
  category  String   // crypto | forex | commodities | indices | system
  provider  String   // TD | FH | BN | KR | MV
  errorType String   // API_KEY | WS_CONNECT | WS_ERROR | WS_TIMEOUT
  message   String
  ts        DateTime @default(now())
}
enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  CLIENT
}
enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}
enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}
enum Plan {
  STARTER
  PRO
  ENTERPRISE
}
enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}
enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}
enum AccountType {
  LIVE
  DEMO
}
enum Currency {
  USD
  EUR
  GBP
}
enum Side {
  BUY
  SELL
}
enum CloseReason {
  MANUAL
  TP
  SL
  MC
}
enum FinType {
  DEPOSIT
  WITHDRAWAL
  CREDIT_IN
  CREDIT_OUT
  BONUS
  INSURANCE
  TRANSFER_IN
  TRANSFER_OUT
  PNL_ADJUST
}
enum FinMode {
  REALTIME
  MANUAL
}
enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}
enum AuditCategory {
  SUPERADMIN
  ADMIN
  MANAGER
  CLIENT
}
enum PaymentKind {
  DEPOSIT
  WITHDRAWAL
}
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}