# Copy this to ".env" on the server (next to docker-compose.prod.yml) and fill in.
# Never commit the real .env.

# --- Domain / Caddy (TLS) ---
DOMAIN=cubexenterprises.com
ACME_EMAIL=admin@cubexenterprises.com
ROOT_DOMAIN=cubexenterprises.com
APP_NAME=CubeX

# --- Database (the postgres service in the compose) ---
DB_USER=cubex
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=cubex
DATABASE_URL=postgresql://cubex:CHANGE_ME_strong_db_password@postgres:5432/cubex

# --- Cache / pub-sub ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=CHANGE_ME_long_random_secret
JWT_EXPIRES_IN=7d

# --- Market data feeds ---
# Twelve Data drives REAL prices/candles (forex, metals, crypto, stocks).
# Needs a plan that includes real-time + WebSocket. When set, the platform shows
# real ticks as-is so prices/candles match the real market (TradingView/MT5).
TWELVEDATA_KEY=your_twelvedata_key
FINNHUB_KEY=your_finnhub_key
# Display mode. Default (unset/0) = smooth pip-by-pip movement that tracks the
# real price (best for market watch / chart / P&L). Set to 1 for byte-exact
# candles that snap to each feed tick (movement looks steppy).
REALTIME_EXACT=0

# --- Email (optional; leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@cubexenterprises.com

# --- Web push (optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cubexenterprises.com
