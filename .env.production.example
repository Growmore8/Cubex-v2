# Copy this to ".env" on the server (next to docker-compose.prod.yml) and fill in.
# Never commit the real .env.

# --- Domain / Traefik ---
DOMAIN=cubexenterprises.com
ACME_EMAIL=admin@cubexenterprises.com
ROOT_DOMAIN=cubexenterprises.com
APP_NAME=CubeX

# --- Database (the postgres service in the compose) ---
DB_USER=cubex
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=cubex
DATABASE_URL=postgresql://cubex:CHANGE_ME_strong_db_password@postgres:5432/cubex

# --- Cache / pub-sub ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=CHANGE_ME_long_random_secret
JWT_EXPIRES_IN=7d

# --- Market data feeds ---
TWELVEDATA_KEY=your_twelvedata_key
FINNHUB_KEY=your_finnhub_key

# --- Email (optional; leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@cubexenterprises.com

# --- Web push (optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cubexenterprises.com
