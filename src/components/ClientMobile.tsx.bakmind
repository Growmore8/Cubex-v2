"use client";
import { useEffect, useRef, useState } from "react";
import TVChart from "@/components/TVChart";

const DARK: any = { "--bg": "#131722", "--panel": "#1e222d", "--border": "#363a45", "--text": "#d1d4dc", "--muted": "#848e9c", "--soft": "#2a2e39" };
const LIGHT: any = { "--bg": "#f1f5f9", "--panel": "#ffffff", "--border": "#e2e8f0", "--text": "#0f172a", "--muted": "#64748b", "--soft": "#eef2f7" };
const BUY = "#26a69a", SELL = "#ef5350", GOLD = "#0078d7";
const LOTS = [0.01, 0.05, 0.1, 0.5, 1];

export default function ClientMobile({ t }: { t: any }) {
  const [tab, setTab] = useState<"trade" | "market" | "positions" | "account" | "news">("trade");
  const avatarRef = useRef<HTMLInputElement>(null);
  const [news, setNews] = useState<any[]>([]);
  useEffect(() => { if (tab === "news" && news.length === 0) { fetch("/api/client/news?category=forex").then((r) => r.json()).then((dd) => { if (dd.ok) setNews(dd.items || []); }).catch(() => {}); } }, [tab]);
  const {
    theme, account, accts, accId, positions, pending, symbols, prices,
    selSym, vol, orderType, pendingPrice, sl, tp, err,
    balance, equity, floating, free, used, level, price, bid, ask, d, tf, TFS,
    setSelSym, setVol, setSl, setTp, setOrderType, setPendingPrice, setTf,
    place, close, cancelPending, switchAcc, openAccount, topUp, toggleTheme, enablePush, addPasskey, openPin,
    fmt, csz, pnlOf, dg, pin, favs, toggleFav, avatarUrl, uploadAvatar,
  } = t;
  const curAcct = accts.find((a: any) => a.id === accId);
  const groups: Record<string, any[]> = {};
  symbols.forEach((s: any) => { const c = s.category || "other"; (groups[c] || (groups[c] = [])).push(s); });

  const TabBtn = ({ k, label }: any) => (
    <button onClick={() => setTab(k)} className="flex-1 py-2 text-[11px]" style={{ color: tab === k ? BUY : "var(--muted)" }}>{label}</button>
  );

  return (
    <div style={{ ...(theme === "dark" ? DARK : LIGHT), fontFamily: "Tahoma, 'Segoe UI', sans-serif" }} className="flex h-screen flex-col overflow-hidden bg-[var(--bg)] text-[var(--text)]">
      {/* top bar */}
      <div className="flex items-center justify-between border-b border-[var(--border)] bg-[var(--panel)] px-3 py-2">
        <div className="flex items-center gap-2">
          <span className="inline-block h-4 w-4 rounded bg-[#3b82f6]" />
          <select value={accId} onChange={(e) => switchAcc(e.target.value)} className="rounded border border-[var(--border)] bg-[var(--bg)] px-1.5 py-1 text-[11px] text-[var(--text)]">
            {accts.map((a: any) => <option key={a.id} value={a.id}>{a.login} - {a.type}</option>)}
          </select>
        </div>
        <div className="text-right text-[10px]" style={{ color: GOLD }}>
          <div>Equity <span className="text-[var(--text)]">{account ? fmt(equity) : "--"}</span></div>
          <div>Free <span className="text-[var(--text)]">{account ? fmt(free) : "--"}</span></div>
        </div>
      </div>

      <div className="min-h-0 flex-1 overflow-auto">
        {tab === "trade" && (
          <div className="flex h-full flex-col">
            <div className="flex items-center justify-between border-b border-[var(--border)] bg-[var(--panel)] px-3 py-1.5">
              <button onClick={() => setTab("market")} className="text-sm font-semibold">{selSym || "--"} ▾</button>
              <div className="flex gap-1">{TFS.map((x: string) => <button key={x} onClick={() => setTf(x)} className="rounded px-1.5 py-0.5 text-[10px]" style={tf === x ? { background: BUY, color: "#04140e" } : { color: "var(--muted)" }}>{x}</button>)}</div>
            </div>
            <div className="relative h-[38vh] bg-[var(--bg)]"><TVChart symbol={selSym} tf={tf} theme={theme} /></div>
            <div className="p-3">
              <div className="mb-2 grid grid-cols-2 gap-1">
                <div className="rounded py-2 text-center" style={{ background: theme === "dark" ? "#241016" : "#fde8e8" }}><div className="text-[9px] text-[var(--muted)]">BID</div><div className="text-base" style={{ color: SELL }}>{price != null ? bid.toFixed(d) : "..."}</div></div>
                <div className="rounded py-2 text-center" style={{ background: theme === "dark" ? "#0f2018" : "#e6f7ef" }}><div className="text-[9px] text-[var(--muted)]">ASK</div><div className="text-base" style={{ color: BUY }}>{price != null ? ask.toFixed(d) : "..."}</div></div>
              </div>
              <div className="mb-2 flex gap-1 text-[10px]">
                <button onClick={() => setOrderType("MARKET")} className="flex-1 rounded py-1.5" style={orderType === "MARKET" ? { background: "#16243a", color: "#5aa9ff" } : { color: "var(--muted)" }}>Market</button>
                <button onClick={() => setOrderType("PENDING")} className="flex-1 rounded py-1.5" style={orderType === "PENDING" ? { background: "#16243a", color: "#5aa9ff" } : { color: "var(--muted)" }}>Pending</button>
              </div>
              {orderType === "PENDING" && (<input type="number" value={pendingPrice} onChange={(e) => setPendingPrice(e.target.value)} placeholder="Trigger price" className="mb-2 w-full rounded border border-[var(--border)] bg-[var(--bg)] px-2 py-2 text-center text-sm text-[var(--text)]" />)}
              <div className="mb-1 flex items-center gap-2">
                <button onClick={() => setVol((v: number) => Math.max(0.01, +(v - 0.01).toFixed(2)))} className="rounded border border-[var(--border)] px-3 py-1 text-lg">-</button>
                <input type="number" step="0.01" value={vol} onChange={(e) => setVol(Number(e.target.value))} className="flex-1 rounded border border-[var(--border)] bg-[var(--bg)] px-2 py-2 text-center text-sm text-[var(--text)]" />
                <button onClick={() => setVol((v: number) => +(v + 0.01).toFixed(2))} className="rounded border border-[var(--border)] px-3 py-1 text-lg">+</button>
              </div>
              <div className="mb-2 flex gap-1">{LOTS.map((l) => <button key={l} onClick={() => setVol(l)} className="flex-1 rounded py-1 text-[10px]" style={vol === l ? { background: BUY, color: "#04140e" } : { border: "1px solid var(--border)", color: "var(--muted)" }}>{l}</button>)}</div>
              <div className="mb-2 grid grid-cols-2 gap-2">
                <input value={sl} onChange={(e) => setSl(e.target.value)} placeholder="Stop loss" className="w-full rounded border border-[var(--border)] bg-[var(--bg)] px-2 py-2 text-[11px] text-[var(--text)]" />
                <input value={tp} onChange={(e) => setTp(e.target.value)} placeholder="Take profit" className="w-full rounded border border-[var(--border)] bg-[var(--bg)] px-2 py-2 text-[11px] text-[var(--text)]" />
              </div>
              <div className="grid grid-cols-2 gap-2">
                <button onClick={() => place("SELL")} disabled={!account || account?.locked} className="rounded py-3 text-center text-sm font-semibold disabled:opacity-50" style={{ background: SELL, color: "#1a0606" }}>SELL<br /><span className="text-xs">{price != null ? bid.toFixed(d) : "..."}</span></button>
                <button onClick={() => place("BUY")} disabled={!account || account?.locked} className="rounded py-3 text-center text-sm font-semibold disabled:opacity-50" style={{ background: BUY, color: "#04140e" }}>BUY<br /><span className="text-xs">{price != null ? ask.toFixed(d) : "..."}</span></button>
              </div>
              {!account && <div className="mt-2 text-center text-[11px]" style={{ color: SELL }}>No account</div>}
              {err && <div className="mt-2 text-center text-[11px]" style={{ color: SELL }}>{err}</div>}
            </div>
          </div>
        )}

        {tab === "market" && (
          <div className="p-2 text-[12px]">
            {favs.length > 0 && (
              <div>
                <div className="mt-1 rounded bg-[var(--soft)] px-2 py-1 text-[10px] font-semibold" style={{ color: GOLD }}>{"\u2605"} FAVOURITES</div>
                {symbols.filter((s: any) => favs.includes(s.symbol)).map((s: any) => { const pp = prices[s.symbol]; const dd = dg(s.symbol); return (
                  <div key={"mf-" + s.symbol} className="flex w-full items-center justify-between border-b border-[var(--border)] px-2 py-2">
                    <button onClick={() => { setSelSym(s.symbol); setTab("trade"); }} className="flex-1 text-left">{s.symbol}</button>
                    <span className="text-[var(--muted)]">{pp != null ? pp.toFixed(dd) : "..."}</span>
                    <button onClick={() => toggleFav(s.symbol)} className="ml-3" style={{ color: GOLD }}>{"\u2605"}</button>
                  </div>); })}
              </div>
            )}
            {Object.entries(groups).map(([c, list]) => (
              <div key={c}>
                <div className="mt-1 rounded bg-[var(--soft)] px-2 py-1 text-[10px] font-semibold text-[var(--muted)]">{c.toUpperCase()}</div>
                {list.map((s: any) => { const pp = prices[s.symbol]; const dd = dg(s.symbol); const isFav = favs.includes(s.symbol); return (
                  <div key={s.symbol} className="flex w-full items-center justify-between border-b border-[var(--border)] px-2 py-2">
                    <button onClick={() => { setSelSym(s.symbol); setTab("trade"); }} className="flex-1 text-left">{s.symbol}</button>
                    <span className="text-[var(--muted)]">{pp != null ? pp.toFixed(dd) : "..."}</span>
                    <button onClick={() => toggleFav(s.symbol)} className="ml-3" style={{ color: isFav ? GOLD : "var(--muted)" }}>{"\u2605"}</button>
                  </div>); })}
              </div>
            ))}
          </div>
        )}

        {tab === "positions" && (
          <div className="p-2 text-[12px]">
            <div className="mb-1 text-[10px] font-semibold text-[var(--muted)]">OPEN POSITIONS</div>
            {positions.length > 0 && <div className="mb-1 flex flex-wrap gap-x-3 gap-y-0.5 px-2 text-[10px] text-[var(--muted)]"><span>Trades: <span className="text-[var(--text)]">{positions.length}</span></span><span>Lots: <span className="text-[var(--text)]">{positions.reduce((a: number, p: any) => a + Number(p.lots), 0).toFixed(2)}</span></span><span>P/L: <span style={{ color: floating >= 0 ? BUY : SELL }}>{fmt(floating)}</span></span></div>}
            {positions.length === 0 ? <div className="px-2 py-3 text-[var(--muted)]">No open positions.</div> : positions.map((p: any) => { const cur = prices[p.symbol] ?? p.openPrice; const plv = pnlOf(p, cur, csz(p.symbol)); return (
              <div key={p.id} className="flex items-center justify-between border-b border-[var(--border)] px-2 py-2">
                <div><div>{p.symbol} <span style={{ color: p.type === "BUY" ? BUY : SELL }}>{p.type}</span></div><div className="text-[10px] text-[var(--muted)]">{p.lots} @ {p.openPrice.toFixed(dg(p.symbol))}</div></div>
                <div className="text-right"><div style={{ color: plv >= 0 ? BUY : SELL }}>{(plv >= 0 ? "+$" : "-$") + fmt(Math.abs(plv))}</div><button onClick={() => close(p.id)} className="text-[10px]" style={{ color: SELL }}>Close</button></div>
              </div>); })}
            <div className="mb-1 mt-3 text-[10px] font-semibold text-[var(--muted)]">PENDING</div>
            {pending.length === 0 ? <div className="px-2 py-3 text-[var(--muted)]">No pending orders.</div> : pending.map((o: any) => (
              <div key={o.id} className="flex items-center justify-between border-b border-[var(--border)] px-2 py-2">
                <div>{o.symbol} <span style={{ color: o.side === "BUY" ? BUY : SELL }}>{o.side}</span> <span className="text-[10px] text-[var(--muted)]">{o.kind} {o.lots} @ {Number(o.price).toFixed(dg(o.symbol))}</span></div>
                <button onClick={() => cancelPending(o.id)} className="text-[10px]" style={{ color: SELL }}>Cancel</button>
              </div>))}
          </div>
        )}

        {tab === "account" && (
          <div className="p-3 text-[12px]">
            <div className="mb-3 flex items-center gap-3">
              <input type="file" accept="image/*" style={{ display: "none" }} ref={avatarRef} onChange={uploadAvatar} />
              <button onClick={() => avatarRef.current && avatarRef.current.click()} className="h-14 w-14 overflow-hidden rounded-full border border-[var(--border)]">{avatarUrl ? <img src={avatarUrl} alt="" className="h-full w-full object-cover" /> : <span className="inline-block h-full w-full bg-[#3b82f6]" />}</button>
              <div><div className="text-sm font-semibold">{curAcct ? curAcct.login : ""}</div><button onClick={() => avatarRef.current && avatarRef.current.click()} className="text-[11px] text-[var(--muted)]">Change photo</button></div>
            </div>
            <div className="rounded-lg border border-[var(--border)] bg-[var(--panel)] p-3" style={{ color: GOLD }}>
              <div className="flex justify-between"><span>Balance</span><span className="text-[var(--text)]">{account ? fmt(balance) : "--"}</span></div>
              <div className="flex justify-between"><span>Floating P/L</span><span style={{ color: floating >= 0 ? BUY : SELL }}>{account ? fmt(floating) : "--"}</span></div>
              <div className="flex justify-between"><span>Equity</span><span className="text-[var(--text)]">{account ? fmt(equity) : "--"}</span></div>
              <div className="flex justify-between"><span>Used Margin</span><span className="text-[var(--text)]">{account ? fmt(used) : "--"}</span></div>
              <div className="flex justify-between"><span>Free Margin</span><span className="text-[var(--text)]">{account ? fmt(free) : "--"}</span></div>
              <div className="flex justify-between"><span>Margin Level</span><span className="text-[var(--text)]">{account && level ? level.toFixed(1) + "%" : "--"}</span></div>
            </div>
            <div className="mt-3 grid grid-cols-2 gap-2 text-[12px]">
              <a href="/client/wallet" className="rounded py-2 text-center" style={{ background: BUY, color: "#04140e" }}>Deposit</a>
              <a href="/client/wallet" className="rounded border border-[var(--border)] py-2 text-center">Withdraw</a>
              <a href="/client/kyc" className="rounded border border-[var(--border)] py-2 text-center">KYC</a>
              <button onClick={openPin} className="rounded border border-[var(--border)] py-2">PIN</button>
              <button onClick={enablePush} className="rounded border border-[var(--border)] py-2">Push alerts</button>
              <button onClick={addPasskey} className="rounded border border-[var(--border)] py-2">Add passkey</button>
              <button onClick={() => openAccount("DEMO")} className="rounded border border-[var(--border)] py-2">+ Demo</button>
              <button onClick={() => openAccount("LIVE")} className="rounded border border-[var(--border)] py-2">+ Live</button>
              {curAcct?.type === "DEMO" && <button onClick={topUp} className="rounded py-2" style={{ background: GOLD, color: "#1a1300" }}>Top up</button>}
              <button onClick={toggleTheme} className="rounded border border-[var(--border)] py-2">{theme === "dark" ? "Light mode" : "Dark mode"}</button>
            </div>
            <button onClick={async () => { await fetch("/api/auth/logout", { method: "POST" }); window.location.href = "/login"; }} className="mt-3 w-full rounded py-2" style={{ background: SELL, color: "#1a0606" }}>Logout</button>
          </div>
        )}
        {tab === "news" && (
          <div className="p-2 text-[12px]">
            {news.length === 0 ? <div className="p-4 text-center text-[var(--muted)]">Loading news...</div> : news.map((n: any) => (
              <a key={n.id} href={n.url} target="_blank" rel="noreferrer" className="block border-b border-[var(--border)] px-2 py-2">
                <div className="font-medium text-[var(--text)]">{n.headline}</div>
                <div className="mt-0.5 text-[10px] text-[var(--muted)]">{n.source} - {new Date(n.datetime * 1000).toLocaleString()}</div>
              </a>
            ))}
          </div>
        )}
      </div>

      {/* bottom tab bar */}
      <div className="flex border-t border-[var(--border)] bg-[var(--panel)]">
        <TabBtn k="trade" label="Trade" />
        <TabBtn k="market" label="Market" />
        <TabBtn k="positions" label={"Positions " + positions.length} />
        <TabBtn k="account" label="Account" />
        <TabBtn k="news" label="News" />
      </div>

      {/* PIN change modal */}
      {pin.pinModal && (
        <div className="fixed inset-0 z-[95] flex items-center justify-center p-6" style={{ background: "rgba(0,0,0,0.5)" }} onClick={() => pin.setPinModal(false)}>
          <div className="w-full max-w-[320px] rounded-lg border p-4" style={{ background: "var(--panel)", borderColor: "var(--border)", color: "var(--text)" }} onClick={(e) => e.stopPropagation()}>
            <div className="mb-2 text-sm font-semibold">{pin.pinHasPin ? "Change PIN" : "Set PIN"}</div>
            {pin.pinHasPin && (<><div className="text-[10px] text-[var(--muted)]">Current PIN</div><input type="password" inputMode="numeric" value={pin.pinForm.current || ""} onChange={(e) => pin.setPinForm({ ...pin.pinForm, current: e.target.value })} className="mb-2 mt-1 w-full rounded border border-[var(--border)] bg-[var(--bg)] px-2 py-2 text-center text-[var(--text)]" /></>)}
            <div className="text-[10px] text-[var(--muted)]">New PIN (4-6 digits)</div>
            <input type="password" inputMode="numeric" value={pin.pinForm.pin || ""} onChange={(e) => pin.setPinForm({ ...pin.pinForm, pin: e.target.value })} className="mt-1 w-full rounded border border-[var(--border)] bg-[var(--bg)] px-2 py-2 text-center text-[var(--text)]" />
            {pin.pinErr && <div className="mt-2 text-[10px]" style={{ color: SELL }}>{pin.pinErr}</div>}
            <button onClick={pin.savePin} className="mt-3 w-full rounded py-2 text-xs" style={{ background: BUY, color: "#04140e" }}>Save PIN</button>
          </div>
        </div>
      )}

      {/* PIN lock overlay */}
      {pin.pinLock && (
        <div className="fixed inset-0 z-[120] flex items-center justify-center p-6" style={{ background: "rgba(5,9,16,0.96)" }}>
          <div className="w-full max-w-[320px] rounded-lg border p-5 text-center" style={{ background: "var(--panel)", borderColor: "var(--border)", color: "var(--text)" }}>
            <div className="mb-1 text-sm font-semibold">Enter your PIN</div>
            <div className="mb-3 text-[10px] text-[var(--muted)]">This terminal is locked.</div>
            <input type="password" inputMode="numeric" autoFocus value={pin.pinInput} onChange={(e) => pin.setPinInput(e.target.value)} onKeyDown={(e) => { if (e.key === "Enter") pin.unlock(); }} className="w-full rounded border border-[var(--border)] bg-[var(--bg)] px-2 py-2 text-center text-lg tracking-widest text-[var(--text)]" />
            {pin.pinErr && <div className="mt-2 text-[10px]" style={{ color: SELL }}>{pin.pinErr}</div>}
            <button onClick={pin.unlock} className="mt-3 w-full rounded py-2 text-xs" style={{ background: BUY, color: "#04140e" }}>Unlock</button>
            <button onClick={pin.unlockPasskey} className="mt-2 w-full rounded border border-[var(--border)] py-2 text-xs">Unlock with passkey</button>
          </div>
        </div>
      )}
    </div>
  );
}