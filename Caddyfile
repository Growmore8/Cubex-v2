# CubeX V2 — Caddy reverse proxy.
#
# Routing:
#   cubexenterprises.com, www.*   -> static landing page (served from /srv/landing)
#   trade.cubexenterprises.com    -> the platform (app)
#   db.* / files.*                -> Adminer / Filebrowser
#   <any broker custom domain>    -> the platform (on-demand TLS, gated by the app)
#
# TLS:
#   - Named hosts (apex, www, trade.) use normal AUTOMATIC TLS (provisioned by Caddy).
#   - db./files. + the broker catch-all use ON-DEMAND TLS, gated by
#     /api/internal/tls-check, so nothing is issued for an unknown/abusive host.
#
# Env (from .env): ACME_EMAIL, DOMAIN (platform domain, e.g. cubexenterprises.com)
# The landing repo (https://github.com/Growmore8/landing-page) is cloned on the host
# OUTSIDE this project (e.g. /opt/landing-page) and mounted read-only at /srv/landing
# (see docker-compose.prod.yml). It is never part of the platform project/git.

{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/internal/tls-check
	}
}

# --- Landing page (static) on the apex + www ; automatic TLS ---
{$DOMAIN}, www.{$DOMAIN} {
	root * /srv/landing
	file_server
	encode gzip
}

# --- Platform ; automatic TLS ---
trade.{$DOMAIN} {
	reverse_proxy app:3000
}

# --- Admin tools ; on-demand (their DNS may not be set yet) ---
db.{$DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy adminer:8080
}
files.{$DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy filebrowser:80
}

# --- Every broker custom domain -> platform (cert issued per host on first hit) ---
:443 {
	tls {
		on_demand
	}
	reverse_proxy app:3000
}

# Send plain HTTP to HTTPS for every host.
:80 {
	redir https://{host}{uri} permanent
}
